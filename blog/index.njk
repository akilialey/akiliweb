<section class="page-hero dark glow" aria-labelledby="blog-title">
  <div class="wrap">
    <ol class="crumbs"><li><a href="/">Home</a></li><li aria-current="page">Blog</li></ol>
    <h1 id="blog-title">The Bid Desk Blog</h1>
    <p class="lead">Straight answers on RFPs, government tenders and bid strategy. How to find the right opportunities, price them, and win contracts that pay.</p>
  </div>
</section>

<section class="section-tight tint" aria-label="All posts">
  <div class="wrap">
    <div class="post-grid">
      {%- for post in collections.posts %}
      <a class="card post-card" href="{{ post.url }}">
        <span class="badge">{{ post.data.eyebrow or "Bid strategy" }}</span>
        <h2>{{ post.data.title }}</h2>
        <p>{{ post.data.excerpt }}</p>
        <p class="post-meta"><span><time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time></span><span>{{ post.content | readingTime }}</span></p>
      </a>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="section dark glow" aria-labelledby="blog-cta">
  <div class="wrap cta-band">
    <div>
      <h2 id="blog-cta">Have an RFP on your desk right now?</h2>
      <p class="lead">Get an honest first read within one business day.</p>
    </div>
    <div class="actions">
      <a href="https://calendly.com/thebiddesk" target="_blank" rel="noopener" class="btn btn-gold">Book a free Bid Health Check <svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a>
      <a href="/#contact" class="btn btn-ghost">Send an RFP</a>
    </div>
  </div>
</section>
