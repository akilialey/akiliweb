  <url><loc>https://thebiddesk.ca/services</loc><lastmod>{{ build.date }}</lastmod><priority>0.9</priority></url>
  <url><loc>https://thebiddesk.ca/blog/</loc><lastmod>{{ build.date }}</lastmod><priority>0.8</priority></url>
{%- for post in collections.posts %}
